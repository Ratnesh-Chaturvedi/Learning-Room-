{
  "name": "backend",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:bun": "bun --watch src/server.ts",
    "dev:tsx": "tsx watch src/server.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc",
    "start": "tsx src/server.ts",
    "start:bun": "bun src/server.ts",
    "test:sockets": "tsx tests/sockets.test.ts",
    "test:knock": "tsx tests/privateRoomKnock.test.ts",
    "test:termination": "tsx tests/roomTermination.test.ts",
    "test:scheduled": "tsx tests/scheduledRoom.test.ts",
    "test:goals": "tsx tests/goal.test.ts",
    "test:all": "tsx tests/sockets.test.ts && tsx tests/roomTermination.test.ts && tsx tests/privateRoomKnock.test.ts && tsx tests/scheduledRoom.test.ts && tsx tests/goal.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:push": "bunx prisma db push",
    "prisma:pull": "bunx prisma db pull",
    "prisma:studio": "bunx prisma studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7",
    "@prisma/client": "^7",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "prisma": "^7",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
